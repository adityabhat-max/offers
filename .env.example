# Live Google Sheets sync (service account) — see README.md "Live sync setup"
SHEET_ID=your-google-sheet-id
SHEET_RANGE=A:C
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Optional: pin the board's fallback data + heading to a specific month instead
# of the current calendar month, e.g. BOARD_MONTH=2026-09
BOARD_MONTH=
