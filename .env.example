# Copy this file to .env for local `vercel dev` testing, and set the same
# three variables in the Vercel dashboard (Project Settings -> Environment
# Variables) before deploying. Never commit the real .env file.

AUTH_EMAIL=you@example.com
AUTH_PASSWORD=choose-a-strong-password
AUTH_SECRET=a-long-random-string-used-to-sign-session-cookies

# Optional: pin the board to a specific month instead of the current
# calendar month, e.g. BOARD_MONTH=2026-09
BOARD_MONTH=
